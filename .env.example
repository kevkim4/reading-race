# Copy this file to .env and fill in your own values.

# Your own OAuth client ID (Web application) from Google Cloud Console, made by
# the account that owns this deployment. It looks like
# 1234567890-abc123.apps.googleusercontent.com. Add your server's URL under
# "Authorized JavaScript origins". Leave unset on your own computer to use the
# built-in test sign-in instead (see README); test sign-in never runs on a
# deployed server (NODE_ENV=production or Render).
GOOGLE_CLIENT_ID=

# Only Google accounts on this domain can sign in. Leave unset to allow any
# Google account (fine for local testing, not recommended once this is
# reachable by anyone outside your school).
ALLOWED_EMAIL_DOMAIN=suwoncca.org

# Comma-separated list of teacher emails who get admin access (set the race's
# start/deadline dates, see and delete any class). Must also be valid
# @ALLOWED_EMAIL_DOMAIN accounts to actually sign in. Include a shared school
# account so admin access doesn't depend on any one person.
ADMIN_EMAILS=

# Any long random string — used to sign teacher session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Port the server listens on.
PORT=3000

# Postgres connection string. Get a free one from https://neon.tech (or any
# other Postgres host) — see "Database setup" in the README. Must include
# ?sslmode=require for a hosted database; a local Postgres for development
# usually doesn't need it.
DATABASE_URL=
