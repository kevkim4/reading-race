# Copy this file to .env and fill in your own values.

# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (Web application). Add your server's URL under "Authorized JavaScript origins".
# Leave unset to use the built-in test sign-in instead (see README).
GOOGLE_CLIENT_ID=

# Any long random string — used to sign teacher session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Port the server listens on.
PORT=3000

# Where the SQLite database file is stored. Defaults to ./data/reading-race.db
DB_PATH=
